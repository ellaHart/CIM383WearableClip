# Copy to web/.env.local for the local test server (gitignored). Use long random values.
# On Vercel, set CONTROL_TOKEN and DEVICE_TOKEN in Project Settings -> Environment Variables;
# the Upstash Redis integration adds KV_REST_API_URL and KV_REST_API_TOKEN for you.
CONTROL_TOKEN=replace-with-a-long-random-string
DEVICE_TOKEN=replace-with-a-different-long-random-string

# Leave these out locally to use an in-memory store (forgets everything on restart).
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
